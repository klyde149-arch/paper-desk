# Токен УЖЕ СУЩЕСТВУЮЩЕГО бота из BotFather — тот же, что у ассистента.
# Нужен только для проверки подписи initData и для set-menu-button.js.
# Этот сервер НЕ поллит Telegram: getUpdates держит assistant/bot.py, и второй
# поллер на том же токене получит 409 и уронит ассистента.
BOT_TOKEN=123456789:replace_me

# Публичный HTTPS URL Mini App (туннель на локальный PORT или домен).
WEB_APP_URL=https://example.com

# Порт HTTP API и статики.
PORT=3000

# Кто имеет доступ к кабинету: telegram user id через запятую.
# ПУСТО = пускаем любого, кто открыл приложение из Telegram, — для боевого счёта так нельзя.
ALLOWED_TELEGRAM_IDS=

# Боевое состояние RF-контура (пишет tools/live_rf_engine.ps1). Путь от папки telegram-mini-app.
RF_DATA_DIR=../data/live_rf

# Русские названия активов: BR -> «нефть Brent».
NAMES_RU_PATH=../data/names_ru.json

# SQLite: пользователи и журнал доступа. Торговых данных не хранит.
DATABASE_PATH=./data/mini-app.sqlite

# initData старше этого срока отклоняется.
INIT_DATA_MAX_AGE_SECONDS=86400

# Только для обычного браузера при локальной разработке. В проде — false.
DEV_ALLOW_UNSAFE_AUTH=false
