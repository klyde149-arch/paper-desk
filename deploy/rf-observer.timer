[Unit]
Description=paper-desk RF strategy observer - раз в сутки, после дневного хука движка

[Timer]
# 00:50 MSK. Дневной хук движка идёт в 00:20 и докатывает дневные серии - наблюдатель читает
# уже готовые бары и не соревнуется с ним за файлы. Часовые свечи прошедшего дня к этому
# моменту у биржи тоже полные.
OnCalendar=*-*-* 00:50:00
AccuracySec=1m
# пропущенный запуск догонять не надо: следующий прогон сам увидит непрочитанные дни
Persistent=false

[Install]
WantedBy=timers.target
