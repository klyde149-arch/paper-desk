# /etc/ai-agent.env - владелец root:trader, права 0640. Шаблон, настоящий файл в git не кладётся.
#
# Ключ OpenRouter агента. Решение владельца 28.09.2026: тот же ключ, что у ассистента
# (/etc/trading-assistant.env), лимита на уровне ключа нет - потолки держит код (ниже).
# Имя переменной своё, чтобы агент никогда молча не взял ключ боевого движка из trading-live.env.
AI_AGENT_OPENROUTER_KEY=sk-or-v1-...
# Бюджет в коде (второй рубеж после лимита на ключе) и потолок в день.
AI_AGENT_BUDGET_USD=12.5
AI_AGENT_DAILY_CAP_USD=1.0
# TG_BOT_TOKEN и TG_CHAT_ID (владелец) берутся из /etc/trading-live.env. TG_CHAT_ID_FUT агент
# не использует: клиенту он не пишет.
